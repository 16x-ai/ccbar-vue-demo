# 复制为 .env 后按环境改。npm run dev 会读取（Vite 读 VITE_ 前缀的；其余由 server/dev.mjs 加载给取票服务）。

# ── 取票服务（server/index.js，示例实现）────────────────────────────────────────
# 监听端口（默认 3100，占用时自动往后找）
# REF_TOKEN_PORT=3100
# 取票口地址：默认同源 /get-token（由 Vite 代理转到取票服务 server/index.js）；构建部署时填你们的地址
# VITE_REF_TOKEN_API=/your/get-token/path

# 平台接口的兜底配置：页面设置里的值优先，这里只是设置留空时的兜底。
# 加签用的 API SECRET 只该留在服务端，不进浏览器。
# CC_API_HOST=https://你们的接口网关
# CC_API_APP_KEY=
# CC_API_APP_SECRET=

# SIP 保活间隔（秒）：默认 600 ＝ 不额外发心跳，只由 JsSIP 每 10 分钟续一次注册；
# 设 25 可恢复 25 秒一次的保活（撑住 nginx/NAT 上的长连接），设 0 关闭。
# VITE_SIP_KEEPALIVE=600

# ── 按客户交付 ────────────────────────────────────────────────────────────────
# 每个客户的接口网关不同：构建时注入默认 API 主机（不设则留空，用户在设置里填）
# VITE_API_HOST=https://客户的接口网关
