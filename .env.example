# 复制为 .env 后按环境改。npm run dev 会读取（Vite 读 VITE_ 前缀的；其余由 server/dev.mjs 加载给 Token 代理）。

# ── WebPhone API（新 SDK 的会话接口，SDK 里写死请求 /webphone/v1/*）─────────────
# 平台网关地址。不填则 SDK 拿不到会话，签入会失败。
# WEBPHONE_PROXY_TARGET=https://你们的接口网关
# 平台实际的前缀，默认 /webphone（等价于不改写）。平台若挂在 /api/webphone，就填 /api/webphone。
# WEBPHONE_API_PREFIX=/webphone
# 或者让页面直连（跳过 dev 代理，需要平台开 CORS）：填完整基地址，含前缀
# VITE_WEBPHONE_API_BASE=https://你们的接口网关

# ── Token 代理 ────────────────────────────────────────────────────────────────
# Token 代理监听端口（默认 3000，占用时自动往后找）
# TOKEN_PORT=3000

# 平台接口路径，默认就是下面两个；环境不同可改（也支持 token 请求体里的 host 带路径前缀）
# CC_WEBPHONE_TOKEN_PATH=/openapi/v1/webphone/tokens
# CC_FS_TOKEN_PATH=/openapi/v1/token/fs

# 页面请求 Token 的地址（默认按约定拼同源 /get-token；填了就用填入的地址，和旧 ccbar.js 页面的 TOKEN_API 一样）
# VITE_TOKEN_API=/your/token/path

# ── 会话形态（默认就是旧平台：token/fs + seat/account/get）──────────────────────
# 页面打 /get-session，由 server/get-session.js 在服务端拼好会话给 SDK。
# 网关若部署了 /webphone/v1/*（新平台），构建时设 VITE_LEGACY_PLATFORM=0 切过去。
# 会话接口地址（默认同源 /get-session）
# VITE_SESSION_API=/your/session/path
# 坐席状态接口地址（默认同源 /set-agent-status）
# VITE_AGENT_STATUS_API=/your/status/path
# 取 Token 的地址（只有新平台形态用得到，默认同源 /get-token）
# VITE_TOKEN_API=/your/token/path
# 软电话 WSS 上要不要挂 fs token（默认 1 = 挂）。参考页（能打通外呼的那套）不挂，
# 有些环境挂了会拿不到出局路由，试 0。
# CC_SIP_WS_TOKEN=0
# SIP 保活间隔（秒）：默认 600 ＝ 不额外发心跳，只由 JsSIP 每 10 分钟续一次注册；
# 设 25 可恢复 25 秒一次的保活（撑住 nginx/NAT 上的长连接），设 0 关闭。
# VITE_SIP_KEEPALIVE=600
# 平台路径（默认就是这三个）
# CC_SEAT_ACCOUNT_PATH=/openapi/token/v1/seat/account/get
# CC_SEAT_STATUS_PATH=/openapi/token/v1/seats/set-status
# CC_SIP_WS_PATH=/api/fs/sip-ws

# ── 按客户交付 ────────────────────────────────────────────────────────────────
# 每个客户的接口网关不同：构建时注入默认 API 主机（不设则留空，用户在设置里填）
# VITE_API_HOST=https://客户的接口网关
